generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { ADMIN INTERN }
enum UserStatus { ACTIVE INACTIVE }
enum TaskStatus { DRAFT ASSIGNED IN_PROGRESS SUBMITTED REVIEWED CANCELLED }
enum AssignmentType { INDIVIDUAL TEAM }
enum SubmissionType { INDIVIDUAL TEAM }
enum SubmissionReviewStatus { PENDING APPROVED NEEDS_CHANGES }
enum AttendanceStatus { PRESENT ABSENT LATE HALF_DAY }
enum MeetingType { GENERAL TEAM INDIVIDUAL }
enum MeetingStatus { SCHEDULED COMPLETED CANCELLED }
enum MeetingAttendanceStatus { PRESENT ABSENT LATE }

model User {
  id                        String               @id @default(cuid())
  name                      String
  email                     String               @unique
  passwordHash              String
  role                      UserRole             @default(INTERN)
  status                    UserStatus           @default(ACTIVE)
  internCode                String?              @unique
  position                  String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  teamMemberships           TeamMember[]
  createdTasks              Task[]               @relation("TaskCreator")
  taskAssignments           TaskAssignment[]     @relation("AssignedIntern")
  submissions               TaskSubmission[]     @relation("SubmissionAuthor")
  receivedSubmissions       TaskSubmission[]     @relation("SubmissionTargetIntern")
  reviewedSubmissions       TaskSubmission[]     @relation("SubmissionReviewer")
  attendanceRecords         Attendance[]         @relation("InternAttendance")
  markedAttendance          Attendance[]         @relation("AttendanceMarker")
  createdMeetings            Meeting[]            @relation("MeetingCreator")
  meetingMemberships        MeetingParticipant[]
  meetingAttendance         MeetingAttendance[]  @relation("MeetingIntern")
  markedMeetingAttendance   MeetingAttendance[]  @relation("MeetingAttendanceMarker")

  @@index([role, status])
}

model Team {
  id              String             @id @default(cuid())
  name            String             @unique
  description     String?
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  members         TeamMember[]
  assignments     TaskAssignment[]
  taskSubmissions TaskSubmission[]   @relation("SubmissionTargetTeam")
  meetings        Meeting[]
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  internId String
  joinedAt DateTime @default(now())
  leftAt   DateTime?
  team     Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  intern   User     @relation(fields: [internId], references: [id], onDelete: Restrict)

  @@unique([teamId, internId])
  @@index([internId, leftAt])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String       @db.Text
  status      TaskStatus   @default(DRAFT)
  deadline    DateTime?
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignments TaskAssignment[]

  @@index([status, deadline])
  @@index([createdById, createdAt])
}

model TaskAssignment {
  id          String         @id @default(cuid())
  taskId      String
  type        AssignmentType
  internId    String?
  teamId      String?
  assignedAt  DateTime       @default(now())
  task        Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  intern      User?          @relation("AssignedIntern", fields: [internId], references: [id], onDelete: Restrict)
  team        Team?          @relation(fields: [teamId], references: [id], onDelete: Restrict)
  submissions TaskSubmission[]

  @@index([internId])
  @@index([teamId])
  @@index([taskId])
}

model TaskSubmission {
  id                  String                 @id @default(cuid())
  assignmentId        String
  submissionType      SubmissionType
  submittedById       String
  submittedForInternId String?
  submittedForTeamId  String?
  content             String?                @db.Text
  referenceUrl        String?
  reviewStatus        SubmissionReviewStatus @default(PENDING)
  reviewNote          String?                @db.Text
  reviewedById        String?
  submittedAt         DateTime               @default(now())
  reviewedAt          DateTime?
  assignment          TaskAssignment         @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  submittedBy         User                   @relation("SubmissionAuthor", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedForIntern  User?                  @relation("SubmissionTargetIntern", fields: [submittedForInternId], references: [id], onDelete: Restrict)
  submittedForTeam    Team?                  @relation("SubmissionTargetTeam", fields: [submittedForTeamId], references: [id], onDelete: Restrict)
  reviewedBy          User?                  @relation("SubmissionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([assignmentId, submittedAt])
  @@index([submittedById, submittedAt])
  @@index([reviewStatus])
}

model Attendance {
  id         String           @id @default(cuid())
  internId   String
  workDate   DateTime         @db.Date
  status     AttendanceStatus
  note       String?          @db.VarChar(500)
  markedById String
  markedAt   DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  intern     User             @relation("InternAttendance", fields: [internId], references: [id], onDelete: Restrict)
  markedBy   User             @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([internId, workDate])
  @@index([workDate, status])
}

model Meeting {
  id           String        @id @default(cuid())
  title        String
  description  String?       @db.Text
  type         MeetingType   @default(GENERAL)
  status       MeetingStatus @default(SCHEDULED)
  startsAt     DateTime
  endsAt       DateTime
  meetingUrl   String?
  teamId       String?
  createdById  String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  team         Team?         @relation(fields: [teamId], references: [id], onDelete: Restrict)
  createdBy    User          @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants MeetingParticipant[]
  attendance   MeetingAttendance[]

  @@index([startsAt, status])
  @@index([teamId])
}

model MeetingParticipant {
  id        String   @id @default(cuid())
  meetingId String
  internId  String
  addedAt   DateTime @default(now())
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  intern    User     @relation(fields: [internId], references: [id], onDelete: Restrict)

  @@unique([meetingId, internId])
  @@index([internId, meetingId])
}

model MeetingAttendance {
  id         String                  @id @default(cuid())
  meetingId  String
  internId   String
  status     MeetingAttendanceStatus
  markedById String
  markedAt   DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  meeting    Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  intern     User                    @relation("MeetingIntern", fields: [internId], references: [id], onDelete: Restrict)
  markedBy   User                    @relation("MeetingAttendanceMarker", fields: [markedById], references: [id], onDelete: Restrict)

  @@unique([meetingId, internId])
  @@index([internId, status])
}
